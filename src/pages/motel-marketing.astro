---
import BaseLayout from '../layouts/BaseLayout.astro';
import PartnerGrid from '../components/PartnerGrid.astro';
import LucideIcon from '../components/LucideIcon.astro';
---

<BaseLayout title="Motel & Hotel Marketing Specialist Services - Book a Free Consult Today!" description="Improve your motel or hotel marketing. We optimise your website speed and intercept guest intent. Shift guests from OTAs to direct bookings. Book a Marketing Audit today." hideFooterCta>
  <!-- 1. Hero (Minimalist & High-Impact) -->
  <section id="hero" class="bg-[#F9F9F8] border-b border-stone-200 pt-24 pb-16">
    <div class="max-w-6xl mx-auto px-6">
      <div class="grid gap-10 md:grid-cols-12 items-start">
        <div class="md:col-span-7" data-reveal="up">
          <h1 class="text-5xl md:text-7xl font-semibold text-stone-900 tracking-tight text-balance">
            Motel Marketing that Increases Direct Bookings.
          </h1>
          <p class="mt-6 text-lg md:text-xl text-stone-500 leading-relaxed text-balance">
            We install a practical marketing system for Australian hotels and motels—so “Direct” becomes the default choice, not the lucky outcome.
          </p>
          <a
            href="/contact/"
            class="mt-8 inline-flex items-center justify-center rounded-lg bg-[#4A554E] px-8 py-4 text-base font-medium text-white shadow-sm hover:bg-[#3d4640] hover:shadow-lg transition"
          >
            Book Your Free Motel Marketing Strategy Session
          </a>
          <p class="mt-4 text-lg text-stone-500">
            🚀 Our last client's website traffic increased by 145%.
          </p>
        </div>

        <!-- Hero Image -->
        <div class="md:col-span-5" data-reveal="up">
          <img 
            src="/images/legacy/motel-marketing-seo-australia-motel-coach.webp" 
            alt="Motel, hotel and accommodation Marketing company in Australia" 
            class="w-full h-auto rounded-2xl shadow-lg border border-stone-200 object-cover"
            width="512"
            height="512"
            loading="eager"
            fetchpriority="high"
            decoding="sync"
          />
        </div>
      </div>
    </div>
  </section>

  <div class="w-full bg-white">
      
      <PartnerGrid />
    </div>

  <!-- 2. Motel Marketing Pillar Content -->
  <section class="bg-stone-50 border-y border-stone-200 py-24">
    <div class="max-w-6xl mx-auto px-6">
      <div class="max-w-5xl" data-reveal="up">
        <h2 class="text-2xl md:text-3xl font-semibold text-stone-900 tracking-tight text-balance">
          The 11-Step Motel Marketing System
        </h2>
        <p class="mt-4 text-stone-500 leading-relaxed">
          At Motel Coach, we are a specialist Australian based motel marketing company and digital agency that actually knows how to operate a motel/hotel. Most online marketing strategies fail because generic corporate agencies do not understand your front desk, booking websites, or guest reviews. At Motel Coach, our consultants are marketing experts in the accommodation (hotel, motel, hostel space) space with real operational capability.
      </div>

      <div class="mt-12 space-y-10">
        {[
          {
            number: '01',
            title: 'Direct Booking Foundations',
            body: 'We start with a focus on growing direct bookings. This starts with your <a href="/motel-website-design/" class="text-[#4A554E] font-medium hover:underline">motel website design</a>, phone, and email. We ensure rates are clear. Policies are simple and booking direct is frictionless. This is the key of marketing your motel to increase your occupancy',
          },
          {
            number: '02',
            title: 'OTA Strategy (Not Dependence)',
            body: 'Use OTAs as billboards, not landlords. Tune Booking.com and Expedia to feed direct demand while controlling commission and cancellation risk. Driving the maximum direct booking ratio vs the dominant OTAs is a marketing skill.',
          },
          {
            number: '03',
            title: 'Website Speed & Conversion',
            body: 'Target sub-2 second loads on patchy regional connections. Clear room facts, fast booking, and clean layout turn visits into bookings.',
          },
          {
            number: '04',
            title: '<a href="/motel-seo/" class="hover:underline hover:text-[#4A554E]">Local hotel & motel SEO</a>',
            body: 'Optimise Google Business Profile, local pages, build citations, local authority and content so “motel near me” and accommodation searches put you in the top map results.',
          },
          {
            number: '05',
            title: 'Google Free Link, Hotel (Sponsored) Ads and Google PPC',
            body: 'Show your direct rate next to the OTAs when guests are ready to book. Intercept intent at the moment of decision on Google.',
          },
          {
            number: '06',
            title: 'Pricing & Offer Structure',
            body: 'Align marketing with simple pricing rules—weekday vs weekend, events, fenced offers—so campaigns and rates support each other.',
          },
          {
            number: '07',
            title: 'Reputation & Review Velocity',
            body: 'Increase review volume to your Google Business Profile (GBP) with a simple, compliant system. Recent reviews lift click-through, bookings, and your rank.',
          },
        ].map((step) => (
          <div class="grid md:grid-cols-12 gap-6 items-start" data-reveal="up">
            <div class="md:col-span-2">
              <div class="text-5xl md:text-6xl font-semibold text-stone-200 tracking-tight leading-none">
                {step.number}
              </div>
            </div>
            <div class="md:col-span-10">
              <h3 class="text-xl md:text-2xl font-semibold text-stone-900 tracking-tight" set:html={step.title} />
              <p class="mt-2 text-stone-500 leading-relaxed" set:html={step.body} />
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Premium Insights: AI + Schema -->
  <section class="bg-stone-50 border-y border-stone-200 py-24">
    <div class="max-w-6xl mx-auto px-6">
      <div class="space-y-12">
        <div class="grid md:grid-cols-12 gap-6 items-start" data-reveal="up">
          <div class="md:col-span-2">
            <div class="text-5xl md:text-6xl font-semibold text-stone-200 tracking-tight leading-none">
              08
            </div>
          </div>
          <div class="md:col-span-10">
            <h3 class="text-xl md:text-2xl font-semibold text-stone-900 tracking-tight">
              AI Marketing: Fact Layer vs. Fluff
            </h3>
            <p class="mt-2 text-stone-500 leading-relaxed">
              AI tools don’t rank adjectives. They rank facts. Replace fluffy copy with dense, verifiable details: King bed sizes, truck parking, Wi‑Fi speeds, late check‑in rules, and real distances.
            </p>
          </div>
        </div>

        <div class="grid md:grid-cols-12 gap-6 items-start" data-reveal="up">
          <div class="md:col-span-2">
            <div class="text-5xl md:text-6xl font-semibold text-stone-200 tracking-tight leading-none">
              09
            </div>
          </div>
          <div class="md:col-span-10">
            <h3 class="text-xl md:text-2xl font-semibold text-stone-900 tracking-tight">
              Schema Marketing: Teach Google your motel
            </h3>
            <p class="mt-2 text-stone-500 leading-relaxed">
              Schema is the translator between your website and search engines. Done correctly, it turns your motel into structured, readable data—making it easier for Google and AI tools to surface you for high-intent searches.
            </p>
          </div>
          </div>
             <div class="grid md:grid-cols-12 gap-6 items-start" data-reveal="up">
          <div class="md:col-span-2">
            <div class="text-5xl md:text-6xl font-semibold text-stone-200 tracking-tight leading-none">
              10
            </div>
          </div>
          <div class="md:col-span-10">
            <h3 class="text-xl md:text-2xl font-semibold text-stone-900 tracking-tight">
              Motel and Hotel Advertising 
            </h3>
            <p class="mt-2 text-stone-500 leading-relaxed">
              Hotel and motel advertising is the art of putting your property in front of travelers online at the exact moment they need a bed, and convincing them to book a room with you.
            </p>
          </div>
        </div>

      <div class="grid md:grid-cols-12 gap-6 items-start" data-reveal="up">
          <div class="md:col-span-2">
            <div class="text-5xl md:text-6xl font-semibold text-stone-200 tracking-tight leading-none">
              11
            </div>
          </div>
          <div class="md:col-span-10">
            <h3 class="text-xl md:text-2xl font-semibold text-stone-900 tracking-tight">
              Motel and Hotel Remarketing 
            </h3>
            <p class="mt-2 text-stone-500 leading-relaxed">
              Motel marketing is all about catching guests at the exact moment they want to book, some of the guests need to see your ad more than once to secure the booking. This is where motel and hotel remarketing is valuable.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Sticky Footer CTA -->
  <div id="sticky-footer-cta" class="fixed inset-x-0 bottom-0 z-40 hidden">
    <div class="bg-white/95 backdrop-blur-sm border-t border-slate-200 shadow-lg">
      <div class="max-w-6xl mx-auto px-6 py-3.5 flex flex-col sm:flex-row items-center justify-between gap-3">
        <p class="text-sm text-slate-600">
          <span class="font-bold text-[#1E293B]">Are you over reliant on Booking.com?</span> — Get field proven Marketing support.
        </p>
        <div class="flex w-full sm:w-auto gap-3">
          <a href="/contact/" class="flex-1 sm:flex-none inline-flex items-center justify-center min-h-[44px] rounded-lg bg-[#4A554E] px-5 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-[#3d4640] transition">
            Contact Us Today
          </a>
        </div>
      </div>
    </div>
  </div>

  <script>
    (function () {
      const bar = document.getElementById('sticky-footer-cta');
      const hero = document.getElementById('hero');
      if (!bar || !hero) return;
      const io = new IntersectionObserver(
        (entries) => {
          if (entries[0].isIntersecting) bar.classList.add('hidden');
          else bar.classList.remove('hidden');
        },
        { root: null, threshold: 0 }
      );
      io.observe(hero);
    })();
  </script>

  <!-- Strategy Session CTA -->
  <section class="bg-[#4A554E] py-14">
    <div class="max-w-4xl mx-auto px-6 flex flex-col md:flex-row items-center justify-between gap-6">
      <div>
        <p class="text-xs font-semibold uppercase tracking-widest text-stone-300 mb-1">Limited Availability</p>
        <h2 class="text-2xl md:text-3xl font-semibold text-white tracking-tight">Schedule a 2-Hour Strategy Session</h2>
        <p class="text-stone-300 text-sm mt-1">Normally $259 — <strong class="text-white">only $135.</strong> We'll identify your highest-impact marketing levers and build a direct bookings plan.</p>
      </div>
      <a href="https://book.stripe.com/4gM00jg79aXP1ej9xx6Zy0g" class="flex-shrink-0 inline-flex items-center justify-center gap-2 px-7 py-3.5 bg-white text-[#4A554E] text-sm font-bold rounded-lg hover:bg-stone-100 transition-colors shadow-sm whitespace-nowrap">
        Book Now — $135
      </a>
    </div>
  </section>
</BaseLayout>
