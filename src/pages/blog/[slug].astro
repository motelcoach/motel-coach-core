---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.hideFromBlog);
  return posts.map(entry => ({
    params: { slug: entry.slug }, props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await entry.render();

function mdLinksToHtml(text: string): string {
  return text.replace(/\[([^\]]+)\]\(([^)]+)\)/g, '<a href="$2">$1</a>');
}

// Related posts: same category, excluding current post, up to 3
const allPosts = await getCollection('blog', ({ data }) => !data.hideFromBlog);
const relatedPosts = allPosts
  .filter(p => p.slug !== entry.slug && p.data.category === entry.data.category)
  .sort((a, b) => new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime())
  .slice(0, 3);

const articleJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: entry.data.title,
  description: entry.data.description ?? '',
  datePublished: new Date(entry.data.pubDate).toISOString(),
  dateModified: new Date(entry.data.updatedDate ?? entry.data.pubDate).toISOString(),
  author: { '@type': 'Person', name: 'Benjamin Douglas' },
  publisher: { '@type': 'Organization', name: 'Motel Coach', url: 'https://motelcoach.com.au/' },
};
---

<BaseLayout title={entry.data.seoTitle ?? `${entry.data.title} | Motel Coach`} description={entry.data.seoDescription ?? entry.data.description}>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(articleJsonLd)} />
  {entry.data.faqs && (
    <script type="application/ld+json" slot="head" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: entry.data.faqs.map((faq: { q: string; a: string }) => ({
        '@type': 'Question',
        name: faq.q,
        acceptedAnswer: { '@type': 'Answer', text: faq.a },
      })),
    })} />
  )}
  <div class="max-w-3xl mx-auto px-6 py-20">
    <a href="/blog/" class="text-[#4A554E] font-medium text-sm hover:text-stone-900 transition-colors">← Back to Blog</a>
    <article class="mt-8 prose prose-lg prose-stone max-w-none prose-headings:text-stone-900 prose-headings:font-semibold prose-headings:tracking-tight prose-p:text-stone-500 prose-p:leading-relaxed prose-a:text-[#4A554E] prose-a:font-medium hover:prose-a:underline prose-blockquote:border-l-[#4A554E] prose-blockquote:bg-brand-50 prose-blockquote:border-stone-200 [&_ul:has(input[type=checkbox])]:pl-0 [&_li:has(input[type=checkbox])]:list-none [&_li:has(input[type=checkbox])]:flex [&_li:has(input[type=checkbox])]:items-start [&_li:has(input[type=checkbox])]:gap-2 [&_input[type=checkbox]]:mt-1 [&_input[type=checkbox]]:h-4 [&_input[type=checkbox]]:w-4 [&_input[type=checkbox]]:shrink-0 [&_input[type=checkbox]]:accent-[#4A554E] prose-table:w-auto prose-table:mx-auto prose-table:border prose-table:border-stone-200 prose-table:rounded-lg prose-th:bg-[#F9F9F8] prose-th:text-[#4A554E] prose-th:p-4 prose-th:border-b-2 prose-th:border-stone-200 prose-td:p-4 prose-td:border-b prose-td:border-stone-100 prose-tr:last:border-b-0">
      <header class="mb-12">
        <p class="text-stone-400 text-sm">{new Date(entry.data.pubDate).toDateString()}</p>
        <h1 class="text-5xl font-semibold text-stone-900 mt-2 tracking-tight">{entry.data.title}</h1>
      </header>
      {entry.data.executiveSummary && (
        <div class="bg-blue-50 border-l-4 border-blue-600 p-6 rounded-r-2xl my-8 not-prose">
          <h2 class="text-xl font-bold text-brand-950 mb-3">Executive Summary: Key Takeaways</h2>
          <p class="text-gray-700 m-0 [&_a]:text-blue-700 [&_a]:underline [&_a]:font-medium hover:[&_a]:text-blue-900"><em set:html={mdLinksToHtml(entry.data.executiveSummary)} /></p>
        </div>
      )}
      <Content />
    </article>
  </div>

  {relatedPosts.length > 0 && (
    <section class="border-t border-stone-100 bg-brand-50 py-16">
      <div class="max-w-3xl mx-auto px-6">
        <h2 class="text-2xl font-semibold text-stone-900 tracking-tight mb-8">Related Articles</h2>
        <div class="grid sm:grid-cols-3 gap-6">
          {relatedPosts.map(post => (
            <a href={`/blog/${post.slug}/`} class="group block bg-white rounded-xl border border-stone-100 p-5 hover:border-[#4A554E] transition-colors no-underline">
              {post.data.category && (
                <span class="text-xs font-bold uppercase tracking-widest text-[#4A554E] mb-2 block">{post.data.category}</span>
              )}
              <p class="text-sm font-semibold text-stone-900 group-hover:text-[#4A554E] transition-colors leading-snug">{post.data.title}</p>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}
</BaseLayout>
