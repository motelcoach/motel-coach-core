---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getEntry } from 'astro:content';

const post = await getEntry('blog', 'motel-seo');
const { Content } = await post.render();
---

<BaseLayout
  title="Motel SEO Specialist | Rank Above OTAs in 2026 | Motel Coach"
  description={post.data.description}
  canonicalURL="https://motelcoach.com.au/motel-seo/"
>
  <section class="w-full bg-[#F9F9F8] pt-32 pb-16 border-b border-stone-200">
    <div class="max-w-3xl mx-auto px-6 text-center">
      <p class="text-xs font-semibold uppercase tracking-widest text-[#4A554E] mb-4">
        {post.data.category || "Motel Marketing"}
      </p>
      <h1 class="text-4xl md:text-5xl font-semibold text-stone-900 tracking-tight text-balance mb-6">
        {post.data.title}
      </h1>
      <p class="text-lg text-stone-500 leading-relaxed text-balance">
        {post.data.description}
      </p>
    </div>
  </section>

  <section class="w-full bg-white py-20">
    <div class="max-w-3xl mx-auto px-6">
      <article class="prose prose-stone lg:prose-lg max-w-none prose-headings:font-semibold prose-headings:tracking-tight prose-headings:text-stone-900 prose-p:text-stone-500 prose-p:leading-relaxed prose-a:text-[#4A554E] prose-a:font-medium prose-a:no-underline hover:prose-a:underline hover:prose-a:decoration-stone-300 prose-blockquote:border-l-[#4A554E] prose-blockquote:bg-[#F9F9F8] prose-blockquote:py-2 prose-blockquote:px-6 prose-blockquote:text-stone-700 prose-blockquote:not-italic prose-blockquote:rounded-r-lg prose-img:rounded-xl prose-img:shadow-sm prose-img:border prose-img:border-stone-200 prose-li:text-stone-500">
        <Content />
      </article>
    </div>
  </section>

  <!-- Marketing Audit CTA -->
  <section class="bg-[#4A554E] py-12">
    <div class="max-w-4xl mx-auto px-6 flex flex-col md:flex-row items-center justify-between gap-4">
      <div>
        <p class="text-xs font-semibold uppercase tracking-widest text-stone-300 mb-1">Quick Win</p>
        <h2 class="text-xl font-semibold text-white">Schedule a $99 Marketing Audit</h2>
        <p class="text-stone-300 text-sm mt-1">Practitioner review of your motel's full digital presence, OTA setup, and website SEO. Actionable findings, fast.</p>
      </div>
      <a href="https://buy.stripe.com/9B67sL9IL1nf7CH7pp6Zy03" class="flex-shrink-0 inline-flex items-center justify-center gap-2 px-6 py-3 bg-white text-[#4A554E] text-sm font-bold rounded-lg hover:bg-stone-100 transition-colors shadow-sm whitespace-nowrap">
        Book $99 Audit
      </a>
    </div>
  </section>
</BaseLayout>
