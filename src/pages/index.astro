---
import BaseLayout from '../layouts/BaseLayout.astro';
import PartnerGrid from '../components/PartnerGrid.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('blog');
const recentPosts = allPosts
  .sort((a, b) => new Date(b.data.pubDate).valueOf() - new Date(a.data.pubDate).valueOf())
  .slice(0, 3);
---

<BaseLayout title="Motel Consultant & Coach | Increase Your Motel Profit" description="Turn your motel into a high-performance asset. Maximize profit and reclaim your time with Motel Coach. Schedule your Profitability Strategy Session today!" canonicalURL="https://motelcoach.com.au/" hideFooterCta>
  
  <section class="w-full bg-[#F9F9F8] pt-24 pb-16 md:pt-32 md:pb-20 border-b border-stone-200">
    <div class="max-w-6xl mx-auto px-6 w-full">
      
      <div class="max-w-6xl">
        <h1 class="text-6xl md:text-6xl lg:text-6xl font-semibold text-stone-900 leading-[1.05] tracking-tight text-balance mb-8">
          We Work with Motel Owners<br />
          <span class="text-stone-400">To Increase Profit.</span>
        </h1>
        
        <!-- Value props -->
        <ul class="space-y-4 mb-10 max-w-xl">
          <li class="flex items-start gap-3">
            <svg class="mt-1 h-5 w-5 text-[#4A554E] flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"></polyline></svg>
            <span class="text-lg text-stone-700"><a href="/motel-management/" class="text-stone-900 font-bold">Motel Management</a> &ndash; Hire and train your on-site management.</span>
          </li>
          <li class="flex items-start gap-3">
            <svg class="mt-1 h-5 w-5 text-[#4A554E] flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"></polyline></svg>
            <span class="text-lg text-stone-700"><a href="/motel-marketing/" class="text-stone-900 font-bold">Motel Marketing</a> &ndash; Get more direct bookings, reduce commission.</span>
          </li>
          <li class="flex items-start gap-3">
            <svg class="mt-1 h-5 w-5 text-[#4A554E] flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"></polyline></svg>
            <span class="text-lg text-stone-700"><a href="/motel-consultancy/" class="text-stone-900 font-bold">Motel Oversight</a> &ndash; Help with running a motel. You can step back.</span>
          </li>
          <li class="flex items-start gap-3">
            <svg class="mt-1 h-5 w-5 text-[#4A554E] flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"></polyline></svg>
            <span class="text-lg text-stone-700"><a href="/motel-management-training-course/" class="text-stone-900 font-bold">Motel Management Course</a> &ndash; We train you how to run a motel (Beginner Friendly)</span>
          </li>
        </ul>

        <!-- Direct contact -->
        <div class="flex flex-col sm:flex-row items-start sm:items-center gap-4 mb-10">
          <a href="tel:+61485510486" class="inline-flex items-center gap-2 px-7 py-3.5 bg-[#4A554E] text-white text-base font-medium rounded-lg hover:bg-[#3d4640] transition-colors shadow-sm">
            <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
            Call Ben: 0485 510 486
          </a>
          <button
            id="email-reveal-btn"
            type="button"
            class="inline-flex items-center gap-2 px-7 py-3.5 bg-white border border-stone-200 text-stone-900 text-base font-medium rounded-lg hover:bg-stone-50 transition-colors shadow-sm cursor-pointer"
          >
            <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
            <span id="email-reveal-text">Email Ben</span>
          </button>
        </div>
      </div>

    </div>
</section>    
     <div class="w-full bg-white">
      
      <PartnerGrid />
    </div>
  
  <!-- Services Grid -->
  <section class="bg-stone-50 border-y border-stone-200 py-24">
    <div class="max-w-6xl mx-auto px-6">
      <div class="max-w-2xl mb-16">
        <h2 class="text-3xl md:text-4xl font-semibold text-stone-900 tracking-tight mb-4">
          Motel Management, Marketing and Training Services
        </h2>
        <p class="text-lg text-stone-500 leading-relaxed">
          Every engagement is anchored to your P&amp;L: more profit, cleaner systems, and less time chained to your motel.
        </p>
      </div>

      <div class="grid gap-6 md:grid-cols-3">
        <!-- Pre-Sale Audit -->
        <a href="/motel-buyers-audit/" class="block bg-white border border-stone-200 p-8 rounded-2xl shadow-sm hover:shadow-md hover:-translate-y-0.5 transition-all duration-300">
          <div class="flex items-center gap-3 mb-4">
            <div class="flex h-10 w-10 items-center justify-center rounded-full bg-[#4A554E]/10">
              <svg class="h-5 w-5 text-[#4A554E]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <rect x="8" y="3" width="8" height="4" rx="1" />
                <path d="M9 3V2h6v1" />
                <rect x="5" y="7" width="14" height="14" rx="2" />
                <path d="M9 11h6M9 15h4" />
              </svg>
            </div>
            <h3 class="text-lg font-semibold text-stone-900 tracking-tight">
              Pre-Sale Audit (Due Diligence)
            </h3>
          </div>
          <p class="text-sm text-stone-500 leading-relaxed mb-4">
            For buyers and vendors who want zero surprises at settlement. We stress-test add-backs, wage assumptions, and capex exposure so you know exactly what you&apos;re buying—or selling. The outcome is a clear-eyed view of risk, not a glossy listing story.
          </p>
          <span class="text-[#4A554E] font-medium text-sm inline-flex items-center gap-1 group-hover:gap-2 transition-all">Learn more &rarr;</span>
        </a>

        <!-- Fractional COO -->
        <a href="/motel-consultancy/" class="block bg-white border border-stone-200 p-8 rounded-2xl shadow-sm hover:shadow-md hover:-translate-y-0.5 transition-all duration-300">
          <div class="flex items-center gap-3 mb-4">
            <div class="flex h-10 w-10 items-center justify-center rounded-full bg-[#4A554E]/10">
              <svg class="h-5 w-5 text-[#4A554E]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <rect x="2" y="7" width="20" height="14" rx="2" />
                <path d="M16 7V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v2" />
                <path d="M2 13h20" />
              </svg>
            </div>
            <h3 class="text-lg font-semibold text-stone-900 tracking-tight">
              Fractional COO
            </h3>
          </div>
          <p class="text-sm text-stone-500 leading-relaxed mb-4">
            For owners who want institutional-grade oversight without a full-time salary. We sit above your managers to align pricing, staffing, and strategy with your long-term asset goals. You keep control of the decisions while handing off the noise.
          </p>
          <span class="text-[#4A554E] font-medium text-sm inline-flex items-center gap-1 group-hover:gap-2 transition-all">Learn more &rarr;</span>
        </a>

        <!-- Motel Manager Recruitment -->
        <a href="/motel-manager-recruitment/" class="block bg-white border border-stone-200 p-8 rounded-2xl shadow-sm hover:shadow-md hover:-translate-y-0.5 transition-all duration-300">
          <div class="flex items-center gap-3 mb-4">
            <div class="flex h-10 w-10 items-center justify-center rounded-full bg-[#4A554E]/10">
              <svg class="h-5 w-5 text-[#4A554E]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" />
                <circle cx="9" cy="7" r="3" />
                <path d="M23 21v-2a4 4 0 0 0-3-3.87" />
                <path d="M16 3.13a3 3 0 0 1 0 5.75" />
              </svg>
            </div>
            <h3 class="text-lg font-semibold text-stone-900 tracking-tight">
              Motel Manager Recruitment
            </h3>
          </div>
          <p class="text-sm text-stone-500 leading-relaxed mb-4">
            We help you source, screen, and onboard managers who can actually run a motel, not just work a reception desk. Clear role design, scorecards, and a 90-day ramp plan reduce churn and protect guest experience. You stop rewriting the same ad every six months.
          </p>
          <span class="text-[#4A554E] font-medium text-sm inline-flex items-center gap-1 group-hover:gap-2 transition-all">Learn more &rarr;</span>
        </a>

        <!-- Motel Marketing -->
        <a href="/motel-marketing/" class="block bg-white border border-stone-200 p-8 rounded-2xl shadow-sm hover:shadow-md hover:-translate-y-0.5 transition-all duration-300">
          <div class="flex items-center gap-3 mb-4">
            <div class="flex h-10 w-10 items-center justify-center rounded-full bg-[#4A554E]/10">
              <svg class="h-5 w-5 text-[#4A554E]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <path d="M3 11v2a4 4 0 0 0 4 4h1" />
                <path d="M21 8v8" />
                <path d="M13 4.5v15" />
                <path d="M3 9a4 4 0 0 1 4-4h1l9-3v22l-9-3H7a4 4 0 0 1-4-4" />
              </svg>
            </div>
            <h3 class="text-lg font-semibold text-stone-900 tracking-tight">
              Motel Marketing
            </h3>
          </div>
          <p class="text-sm text-stone-500 leading-relaxed mb-4">
            No vanity metrics. We focus on shifting guests from OTAs into your own channels, tightening your hotel motel website speed, and using Google Hotel Ads and local SEO to intercept intent. The goal is simple: more direct bookings at higher contribution margin.
          </p>
          <span class="text-[#4A554E] font-medium text-sm inline-flex items-center gap-1 group-hover:gap-2 transition-all">Learn more &rarr;</span>
        </a>

        <!-- Motel Website Development -->
        <a href="/motel-website-design/" class="block bg-white border border-stone-200 p-8 rounded-2xl shadow-sm hover:shadow-md hover:-translate-y-0.5 transition-all duration-300">
          <div class="flex items-center gap-3 mb-4">
            <div class="flex h-10 w-10 items-center justify-center rounded-full bg-[#4A554E]/10">
              <svg class="h-5 w-5 text-[#4A554E]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <rect x="2" y="3" width="20" height="14" rx="2" />
                <path d="M8 21h8M12 17v4" />
                <path d="M7 8l5 5 5-5" />
              </svg>
            </div>
            <h3 class="text-lg font-semibold text-stone-900 tracking-tight">
              Motel Website Development
            </h3>
          </div>
          <p class="text-sm text-stone-500 leading-relaxed mb-4">
            Fast, conversion-focused motel websites built to outrank OTAs and turn Google traffic into direct bookings. Every site we build is optimised for Core Web Vitals, structured data, and mobile-first performance.
          </p>
          <span class="text-[#4A554E] font-medium text-sm inline-flex items-center gap-1 group-hover:gap-2 transition-all">Learn more &rarr;</span>
        </a>

        <!-- Motel SEO -->
        <a href="/motel-seo/" class="block bg-white border border-stone-200 p-8 rounded-2xl shadow-sm hover:shadow-md hover:-translate-y-0.5 transition-all duration-300">
          <div class="flex items-center gap-3 mb-4">
            <div class="flex h-10 w-10 items-center justify-center rounded-full bg-[#4A554E]/10">
              <svg class="h-5 w-5 text-[#4A554E]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="11" cy="11" r="8" />
                <path d="m21 21-4.35-4.35" />
                <path d="M11 8v6M8 11h6" />
              </svg>
            </div>
            <h3 class="text-lg font-semibold text-stone-900 tracking-tight">
              Motel SEO
            </h3>
          </div>
          <p class="text-sm text-stone-500 leading-relaxed mb-4">
            Rank above OTAs in local search and the Google Map Pack. We implement the full motel SEO framework — structured data, Google Business Profile optimisation, and AI-ready content — to intercept guests before Booking.com does.
          </p>
          <span class="text-[#4A554E] font-medium text-sm inline-flex items-center gap-1 group-hover:gap-2 transition-all">Learn more &rarr;</span>
        </a>
      </div>
    </div>
  </section>

  <!-- Authority Section -->
  <section class="w-full bg-white py-24 md:py-32 border-b border-stone-200">
    <div class="max-w-6xl mx-auto px-6 grid gap-12 md:grid-cols-2 md:items-center">
      <div class="order-2 md:order-1">
        <h2 class="text-2xl md:text-3xl font-semibold text-stone-900 tracking-tight mb-4">
          Why Motel Coach?
        </h2>
        
        <p class="text-stone-500 leading-relaxed mb-3">
          We&apos;ve run motels, not just &quot;coached&quot; them. That means we understand <a href="/motel-management/">motel management</a>, how to price rooms without irritating regulars, how to keep the housekeeping team on-side, while driving improvements, and how to structure rosters that match occupancy instead of habit.
        </p>
        <p class="text-stone-500 leading-relaxed mb-3">
          The first motel we operated as Manager, Marketer and Cleaner operated at 9.8/10 on Booking.com for 12-months. The Second Motel we operated started with a 7.8/10 and a 3.3/5 on Booking.com and Google and ended with a 8.6/10 and 4.5/5. Our focus is Financial Performance for our clients, but we get their with a excessive focus on Customer Service.
        </p>
        <p class="text-stone-500 leading-relaxed">
          Our frameworks are built for Australian metro and regional markets with actual boots-on-the-ground experience. We know which reports matter, which KPIs move the needle, and how to turn a busy motel into a high-yield asset instead of a 24/7 job.
        </p>
      </div>
      <div class="order-1 md:order-2">
        <div class="rounded-3xl border border-dashed border-stone-200 bg-[#F5F5F4] shadow-sm p-6">
          <div class="rounded-2xl border border-white/70 bg-gradient-to-br from-[#4A554E] to-stone-900 p-6 text-white shadow-lg flex flex-col gap-4">
            <div>
              <p class="text-xs font-semibold uppercase tracking-widest text-stone-200">
                Motel Coach Profile
              </p>
              <p class="mt-3 text-sm md:text-base font-semibold leading-relaxed">
                We've worked in every role from housekeeping to managing the operations and marketing of a group of 16 motels. We've stripped beds and checked in 1000s of guests.
              </p>
            </div>
            <p class="text-xs text-stone-300">
              Designed from lived experience, not theory.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ Section -->
  <section class="w-full bg-[#F9F9F8] py-24 md:py-32 border-b border-stone-200">
    <div class="max-w-3xl mx-auto px-6">
      <h2 class="text-2xl md:text-3xl font-semibold text-stone-900 tracking-tight mb-6">
        Frequently Asked Questions
      </h2>
      <div class="space-y-4">
        <details class="group rounded-xl border border-stone-200 bg-white p-4">
          <summary class="flex cursor-pointer items-center justify-between gap-4 text-left">
            <span class="text-sm md:text-base font-semibold text-stone-900">
              What if I&apos;m not happy with my current manager&apos;s quality?
            </span>
            <span class="flex h-7 w-7 flex-shrink-0 items-center justify-center rounded-full border border-stone-300 text-stone-500 transition group-open:rotate-45">
              +
            </span>
          </summary>
          <p class="mt-3 text-sm text-stone-500 leading-relaxed">
            We can either stabilise your existing manager with clear KPIs, training, and support—or help you recruit a replacement with a structured onboarding plan. In both cases the goal is the same: a manager who protects profit instead of consuming your time.
          </p>
        </details>

        <details class="group rounded-xl border border-stone-200 bg-white p-4">
          <summary class="flex cursor-pointer items-center justify-between gap-4 text-left">
            <span class="text-sm md:text-base font-semibold text-stone-900">
              Does my motel need to be a certain size for this to work?
            </span>
            <span class="flex h-7 w-7 flex-shrink-0 items-center justify-center rounded-full border border-stone-300 text-stone-500 transition group-open:rotate-45">
              +
            </span>
          </summary>
          <p class="mt-3 text-sm text-stone-500 leading-relaxed">
            No. We work with small regional motels through to larger multi-site portfolios. The levers—distribution, staffing, pricing, and guest experience—exist at every room count; we simply scale the operating rhythm and reporting to match your operation.
          </p>
        </details>

        <details class="group rounded-xl border border-stone-200 bg-white p-4">
          <summary class="flex cursor-pointer items-center justify-between gap-4 text-left">
            <span class="text-sm md:text-base font-semibold text-stone-900">
              How long before I see a return on investment?
            </span>
            <span class="flex h-7 w-7 flex-shrink-0 items-center justify-center rounded-full border border-stone-300 text-stone-500 transition group-open:rotate-45">
              +
            </span>
          </summary>
          <p class="mt-3 text-sm text-stone-500 leading-relaxed">
            Many of our strategies will have an immediate impact - website, ota, pricing, photos for example. For Deeper structural changes and marketing campaigns—like manager upgrades, local seo campaigns, process design, and system changes—compound over months in both cashflow and asset value. Our biggest suggestion, if you are planning on selling your motel, reach out and lets have a discussion, not when you are ready to sell, but 12 to 18 months prior.
          </p>
        </details>

        <details class="group rounded-xl border border-stone-200 bg-white p-4">
          <summary class="flex cursor-pointer items-center justify-between gap-4 text-left">
            <span class="text-sm md:text-base font-semibold text-stone-900">
              How quickly can we start?
            </span>
            <span class="flex h-7 w-7 flex-shrink-0 items-center justify-center rounded-full border border-stone-300 text-stone-500 transition group-open:rotate-45">
              +
            </span>
          </summary>
          <p class="mt-3 text-sm text-stone-500 leading-relaxed">
            We can generally begin within 7 days, depending on your requirements.
          </p>
        </details>

        <details class="group rounded-xl border border-stone-200 bg-white p-4">
          <summary class="flex cursor-pointer items-center justify-between gap-4 text-left">
            <span class="text-sm md:text-base font-semibold text-stone-900">
              Is there a lock-in contract?
            </span>
            <span class="flex h-7 w-7 flex-shrink-0 items-center justify-center rounded-full border border-stone-300 text-stone-500 transition group-open:rotate-45">
              +
            </span>
          </summary>
          <p class="mt-3 text-sm text-stone-500 leading-relaxed">
            No, we want to create long-term relationships built on our performance for your motel.
          </p>
        </details>

        <details class="group rounded-xl border border-stone-200 bg-white p-4">
          <summary class="flex cursor-pointer items-center justify-between gap-4 text-left">
            <span class="text-sm md:text-base font-semibold text-stone-900">
              What PMS or motel systems do you work with?
            </span>
            <span class="flex h-7 w-7 flex-shrink-0 items-center justify-center rounded-full border border-stone-300 text-stone-500 transition group-open:rotate-45">
              +
            </span>
          </summary>
          <p class="mt-3 text-sm text-stone-500 leading-relaxed">
            We work with all motel systems and PMS providers.
          </p>
        </details>

        <details class="group rounded-xl border border-stone-200 bg-white p-4">
          <summary class="flex cursor-pointer items-center justify-between gap-4 text-left">
            <span class="text-sm md:text-base font-semibold text-stone-900">
              What size motels do you work with?
            </span>
            <span class="flex h-7 w-7 flex-shrink-0 items-center justify-center rounded-full border border-stone-300 text-stone-500 transition group-open:rotate-45">
              +
            </span>
          </summary>
          <p class="mt-3 text-sm text-stone-500 leading-relaxed">
            We work with motels of all sizes. Our strategies focus on big-win opportunities for anything from a 4 to 100-room property.
          </p>
        </details>
      </div>
    </div>
  </section>

  <!-- Strategy Session CTA Banner -->
  <section class="w-full bg-[#4A554E] py-14 border-b border-white/10">
    <div class="max-w-4xl mx-auto px-6 flex flex-col md:flex-row items-center justify-between gap-6">
      <div>
        <p class="text-xs font-semibold uppercase tracking-widest text-stone-300 mb-1">Limited Availability</p>
        <h2 class="text-2xl md:text-3xl font-semibold text-white tracking-tight">Schedule a 2-Hour Strategy Session</h2>
        <p class="text-stone-300 text-sm mt-1">Normally $259 — <strong class="text-white">only $135.</strong> A focused session on your motel's biggest profit levers.</p>
      </div>
      <a href="https://book.stripe.com/4gM00jg79aXP1ej9xx6Zy0g" class="flex-shrink-0 inline-flex items-center justify-center gap-2 px-7 py-3.5 bg-white text-[#4A554E] text-sm font-bold rounded-lg hover:bg-stone-100 transition-colors shadow-sm whitespace-nowrap">
        Book Now — $135
      </a>
    </div>
  </section>

  <!-- Latest from the Blog Section -->
  <section class="w-full bg-white py-24 md:py-32 border-b border-stone-200">
    <div class="max-w-6xl mx-auto px-6">
      <div class="flex items-center justify-between mb-12">
        <h2 class="text-3xl md:text-4xl font-semibold text-stone-900 tracking-tight">
          From the Operations Library
        </h2>
        <a href="/blog/" class="hidden md:inline-flex items-center gap-2 text-sm font-medium text-[#4A554E] hover:text-stone-900 transition-colors">
          View all articles &rarr;
        </a>
      </div>
      
      <div class="grid md:grid-cols-3 gap-6">
        {recentPosts.map(post => (
          <a href={`/blog/${post.slug}/`} class="group bg-[#F9F9F8] p-8 rounded-2xl border border-stone-200 shadow-sm hover:shadow-md hover:-translate-y-0.5 transition-all duration-300 flex flex-col h-full">
            <p class="text-xs font-semibold text-[#4A554E] mb-4 uppercase tracking-widest">
              {post.data.category || 'General'}
            </p>
            <h3 class="text-xl font-semibold text-stone-900 group-hover:text-[#4A554E] transition-colors line-clamp-2 mb-3">
              {post.data.title}
            </h3>
            <p class="text-sm text-stone-500 line-clamp-3 leading-relaxed mb-6 flex-grow">
              {post.data.executiveSummary}
            </p>
            <span class="text-[#4A554E] font-medium text-sm inline-flex items-center gap-1 group-hover:gap-2 transition-all mt-auto">
              Read article &rarr;
            </span>
          </a>
        ))}
      </div>
      <div class="mt-8 text-center md:hidden">
        <a href="/blog/" class="inline-flex items-center gap-2 text-sm font-medium text-[#4A554E] hover:text-stone-900 transition-colors">
          View all articles &rarr;
        </a>
      </div>
    </div>
  </section>

  <script>
    (function () {
      var btn = document.getElementById('email-reveal-btn');
      var label = document.getElementById('email-reveal-text');
      if (!btn || !label) return;
      var parts = ['contact', 'motelcoach.com.au'];
      var addr = parts[0] + '@' + parts[1];
      btn.addEventListener('click', function () {
        navigator.clipboard.writeText(addr).then(function () {
          label.textContent = 'Copied! ' + addr;
          btn.classList.add('ring-2', 'ring-[#4A554E]', 'bg-stone-50');
          setTimeout(function () {
            label.textContent = addr;
            btn.classList.remove('ring-2', 'ring-[#4A554E]', 'bg-stone-50');
          }, 3000);
        }).catch(function () {
          label.textContent = addr;
        });
      });
    })();
  </script>

</BaseLayout>