---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Motel Manager Recruitment | Find Your Next Motel Manager | Motel Coach"
  description="Specialist motel manager recruitment for independent Australian motels. We source, screen, and onboard managers — individual managers and couples. Competitive relief manager rates and salary packages."
  hideFooterCta
>
  <!-- Hero -->
  <section class="bg-[#F9F9F8] border-b border-stone-200 py-24">
    <div class="max-w-7xl mx-auto px-6 grid md:grid-cols-12 gap-12 items-start">
      <div class="md:col-span-8">
        <p class="text-xs font-semibold uppercase tracking-widest text-[#4A554E] mb-4">Motel Manager Recruitment</p>
        <h1 class="text-4xl md:text-5xl font-semibold text-stone-900 tracking-tight text-balance mb-6">
          Find a <a href="/motel-management/">Motel Manager</a> Who Actually Runs a Motel
        </h1>
        <p class="text-lg text-stone-500 leading-relaxed mb-4">
          Specialist recruitment for independent Australian motels. We don't just fill a vacancy — we find candidates with the operational skills, temperament, and track record to protect your asset and your guest experience.
        </p>
        <p class="text-stone-500 leading-relaxed mb-8">
          Whether you need a permanent on-site couple, an individual manager, or a vetted relief manager at competitive relief manager rates, we manage the full process from advertising to onboarding.
        </p>
        <div class="flex flex-col sm:flex-row gap-3">
          <a
            href="#vacancy-form"
            class="inline-flex items-center justify-center gap-2 px-7 py-3.5 bg-[#4A554E] text-white font-medium rounded-lg hover:bg-[#3d4640] transition-colors shadow-sm"
          >
            Discuss Your Vacancy
          </a>
          <a
            href="/blog/motel-manager-jobs/"
            class="inline-flex items-center justify-center gap-2 px-7 py-3.5 bg-white border border-stone-200 text-stone-900 font-medium rounded-lg hover:bg-stone-50 transition-colors shadow-sm"
          >
            Job Seeker
          </a>
        </div>
      </div>
      <div class="md:col-span-4">
        <div class="bg-white border border-stone-200 p-6 rounded-xl shadow-sm sticky top-32">
          <p class="text-xs font-semibold uppercase tracking-widest text-stone-400 mb-4">Why Motel Coach Recruitment</p>
          <ul class="space-y-3 text-sm text-stone-600">
            <li class="flex items-start gap-2">
              <svg class="mt-0.5 h-4 w-4 text-[#4A554E] flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
              Candidates assessed against real operational standards
            </li>
            <li class="flex items-start gap-2">
              <svg class="mt-0.5 h-4 w-4 text-[#4A554E] flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
              Individual managers and motel manager couples
            </li>
            <li class="flex items-start gap-2">
              <svg class="mt-0.5 h-4 w-4 text-[#4A554E] flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
              Relief and permanent placement options
            </li>
            <li class="flex items-start gap-2">
              <svg class="mt-0.5 h-4 w-4 text-[#4A554E] flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
              90-day onboarding framework included
            </li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Problem / Why this matters -->
  <section class="bg-white py-24 border-b border-stone-200">
    <div class="max-w-7xl mx-auto px-6">
      <div class="max-w-2xl mb-12">
        <h2 class="text-3xl font-semibold text-stone-900 tracking-tight mb-4">
          The True Cost of a Bad Hire
        </h2>
        <p class="text-lg text-stone-500 leading-relaxed">
          A poor manager doesn't just cost you a salary — they cost you guest reviews, occupancy, and months of operational chaos while you restart the process.
        </p>
      </div>
      <div class="grid gap-6 md:grid-cols-3">
        <div class="bg-[#F9F9F8] border border-stone-200 p-6 rounded-2xl">
          <h3 class="text-lg font-semibold text-stone-900 mb-2">Review Velocity Drops</h3>
          <p class="text-sm text-stone-500 leading-relaxed">Guest satisfaction scores fall within weeks of a poor management transition. A declining review score on Booking.com and Google directly reduces your ranking and rate-setting power.</p>
        </div>
        <div class="bg-[#F9F9F8] border border-stone-200 p-6 rounded-2xl">
          <h3 class="text-lg font-semibold text-stone-900 mb-2">Operational Drift</h3>
          <p class="text-sm text-stone-500 leading-relaxed">Without the right motel manager resume and operational standards, daily processes slip. Linen costs climb, room standards drop, and reporting becomes unreliable within 90 days.</p>
        </div>
        <div class="bg-[#F9F9F8] border border-stone-200 p-6 rounded-2xl">
          <h3 class="text-lg font-semibold text-stone-900 mb-2">The Recruitment Loop</h3>
          <p class="text-sm text-stone-500 leading-relaxed">Motel manager required ads that attract the wrong candidates waste months. Each failed hire sets your operational performance back further and drains owner time and energy.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- How it works -->
  <section id="how-it-works" class="bg-[#F9F9F8] py-24 border-b border-stone-200">
    <div class="max-w-7xl mx-auto px-6">
      <h2 class="text-3xl font-semibold text-stone-900 tracking-tight mb-12">
        Our Recruitment Process
      </h2>
      <div class="grid gap-8 md:grid-cols-2 lg:grid-cols-4">
        {[
          { step: '01', title: 'Role Brief', body: 'We define the role based on your property size, operational style, and owner involvement level — not a generic job description.' },
          { step: '02', title: 'Targeted Search', body: 'We advertise across the right hospitality channels and draw on our existing network of experienced motel managers and couples.' },
          { step: '03', title: 'Operational Screening', body: 'Candidates are assessed against real motel management competencies, not just interview performance. We review motel manager resume quality and references.' },
          { step: '04', title: 'Onboarding Framework', body: 'Every placement comes with a 90-day onboarding plan, KPI framework, and the option of ongoing oversight to protect your investment.' },
        ].map(item => (
          <div class="bg-white border border-stone-200 p-6 rounded-2xl shadow-sm">
            <span class="inline-flex h-9 w-9 items-center justify-center rounded-lg bg-[#4A554E]/10 text-[#4A554E] font-semibold text-sm mb-4">{item.step}</span>
            <h3 class="text-lg font-semibold text-stone-900 mb-2">{item.title}</h3>
            <p class="text-sm text-stone-500 leading-relaxed">{item.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Salary & Rates -->
  <section class="bg-white py-24 border-b border-stone-200">
    <div class="max-w-7xl mx-auto px-6">
      <div class="grid md:grid-cols-2 gap-12 items-start">
        <div>
          <h2 class="text-3xl font-semibold text-stone-900 tracking-tight mb-6">
            Motel Manager Salary & <a href="/blog/motel-relief-manager-jobs/">Relief Manager</a> Rates
          </h2>
          <p class="text-stone-500 leading-relaxed mb-4">
            Motel manager couple salary packages typically depend on property size, location, and the scope of responsibilities. On-site couple packages in Australia generally include accommodation, utilities, and a combined salary, with packages ranging significantly based on room count and role complexity.
          </p>
          <p class="text-stone-500 leading-relaxed mb-4">
            Relief manager rates vary by assignment length and property type. Short-notice or specialist assignments command a premium, while longer-term placements are typically negotiated at a day rate or weekly package inclusive of accommodation.
          </p>
          <p class="text-stone-500 leading-relaxed">
            We provide transparent benchmarking on current market rates for your region and property type as part of the recruitment brief process.
          </p>
        </div>
        <div class="bg-[#F9F9F8] border border-stone-200 rounded-2xl p-8">
          <h3 class="text-xl font-semibold text-stone-900 mb-6">Placement Types</h3>
          <ul class="space-y-5">
            {[
              { type: 'Permanent Couple', desc: 'On-site motel manager couple with live-in accommodation package. Full operational responsibility.' },
              { type: 'Individual Manager', desc: 'Single manager placement for properties with existing support staff or part-time owner involvement.' },
              { type: 'Relief Management', desc: 'Short-term placements at agreed relief manager rates covering annual leave, transition periods, or emergency cover.' },
              { type: 'Fixed-Term Contract', desc: 'Project-based placements for new property openings, refurbishments, or operational resets.' },
            ].map(item => (
              <li class="flex items-start gap-3">
                <svg class="mt-1 h-5 w-5 text-[#4A554E] flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
                <div>
                  <p class="font-semibold text-stone-900 text-sm">{item.type}</p>
                  <p class="text-stone-500 text-sm leading-relaxed">{item.desc}</p>
                </div>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="bg-[#F9F9F8] py-24 border-b border-stone-200">
    <div class="max-w-3xl mx-auto px-6">
      <h2 class="text-3xl font-semibold text-stone-900 tracking-tight mb-10">
        Frequently Asked Questions
      </h2>
      <div class="space-y-4">
        {[
          {
            q: 'What does "motel manager required" mean for my recruitment ad?',
            a: 'It means you have a live vacancy that needs immediate attention. The most effective ads are specific about property size, responsibilities, accommodation arrangements, and salary — vague ads attract unqualified candidates. We help you write and place the right ad to the right audience.',
          },
          {
            q: 'Do you recruit motel manager couples?',
            a: 'Yes. Motel manager couple placements are one of our most common engagement types. We assess both partners separately and together to ensure operational fit, and we structure salary and accommodation packages appropriate to the property.',
          },
          {
            q: 'How is motel manager couple salary structured?',
            a: 'Motel manager couple salary packages typically include a combined remuneration figure covering both partners, live-in accommodation, and in many cases utilities. We benchmark packages against current market rates for your region and property size.',
          },
          {
            q: 'What are typical relief manager rates?',
            a: 'Relief manager rates depend on assignment length, property type, and notice period. We provide transparent market rate guidance as part of every recruitment engagement.',
          },
          {
            q: 'What if the placement doesn\'t work out?',
            a: 'We provide a structured 90-day onboarding framework for every placement, which significantly reduces early attrition. In the rare case a placement fails within a defined period, we will work with you to resolve the situation.',
          },
        ].map(faq => (
          <details class="group rounded-xl border border-stone-200 bg-white p-4">
            <summary class="flex cursor-pointer items-center justify-between gap-4 text-left">
              <span class="text-sm md:text-base font-semibold text-stone-900">{faq.q}</span>
              <span class="flex h-7 w-7 flex-shrink-0 items-center justify-center rounded-full border border-stone-300 text-stone-500 transition group-open:rotate-45">+</span>
            </summary>
            <p class="mt-3 text-sm text-stone-500 leading-relaxed">{faq.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- On-Page Vacancy Form -->
  <section id="vacancy-form" class="bg-white py-24 border-b border-stone-200">
    <div class="max-w-3xl mx-auto px-6">
      <p class="text-xs font-semibold uppercase tracking-widest text-[#4A554E] mb-3">Discuss Your Vacancy</p>
      <h2 class="text-3xl font-semibold text-stone-900 tracking-tight mb-3">Explain Your <a href="/motel-management/">Motel Management</a> Requirements</h2>
      <p class="text-stone-500 leading-relaxed mb-10">Fill out the form below and we'll be in touch to outline how we can find the right manager for your property.</p>

      <div id="vacancy-success" class="hidden py-8 text-center">
        <p class="text-xl font-semibold text-stone-900 mb-2">Enquiry Received</p>
        <p class="text-stone-500">We'll review your vacancy details and be in touch within one business day.</p>
      </div>

      <form id="vacancy-form-el" class="space-y-5" action="https://hooks.zapier.com/hooks/catch/26131104/upwyerc/" method="POST">
        <input type="hidden" name="source_page" value="Motel Manager Recruitment" />
        <input type="hidden" name="form_type" value="vacancy-enquiry" />
        <div class="hidden" aria-hidden="true">
          <input type="text" name="last_name_verification" value="" autocomplete="off" tabindex="-1" />
        </div>

        <div class="grid sm:grid-cols-2 gap-5">
          <div>
            <label for="v-name" class="block text-xs font-semibold uppercase tracking-widest text-stone-400 mb-1.5">Contact Name</label>
            <input id="v-name" name="name" type="text" required placeholder="Your full name"
              class="w-full px-4 py-3 rounded-lg border border-stone-200 text-sm text-stone-900 placeholder-stone-400 focus:outline-none focus:ring-2 focus:ring-[#4A554E] focus:border-transparent" />
          </div>
          <div>
            <label for="v-motel" class="block text-xs font-semibold uppercase tracking-widest text-stone-400 mb-1.5">Motel Name</label>
            <input id="v-motel" name="motel_name" type="text" required placeholder="Your motel's name"
              class="w-full px-4 py-3 rounded-lg border border-stone-200 text-sm text-stone-900 placeholder-stone-400 focus:outline-none focus:ring-2 focus:ring-[#4A554E] focus:border-transparent" />
          </div>
        </div>

        <div class="grid sm:grid-cols-2 gap-5">
          <div>
            <label for="v-email" class="block text-xs font-semibold uppercase tracking-widest text-stone-400 mb-1.5">Email Address</label>
            <input id="v-email" name="email" type="email" required placeholder="you@example.com"
              class="w-full px-4 py-3 rounded-lg border border-stone-200 text-sm text-stone-900 placeholder-stone-400 focus:outline-none focus:ring-2 focus:ring-[#4A554E] focus:border-transparent" />
          </div>
          <div>
            <label for="v-mobile" class="block text-xs font-semibold uppercase tracking-widest text-stone-400 mb-1.5">Mobile Number</label>
            <input id="v-mobile" name="mobile" type="tel" required placeholder="+61 4xx xxx xxx"
              class="w-full px-4 py-3 rounded-lg border border-stone-200 text-sm text-stone-900 placeholder-stone-400 focus:outline-none focus:ring-2 focus:ring-[#4A554E] focus:border-transparent" />
          </div>
        </div>

        <div class="grid sm:grid-cols-2 gap-5">
          <div>
            <label for="v-type" class="block text-xs font-semibold uppercase tracking-widest text-stone-400 mb-1.5">Type of Manager Needed</label>
            <select id="v-type" name="manager_type" required
              class="w-full px-4 py-3 rounded-lg border border-stone-200 text-sm text-stone-900 focus:outline-none focus:ring-2 focus:ring-[#4A554E] focus:border-transparent">
              <option value="" disabled selected>Select one</option>
              <option value="Permanent Individual">Permanent Individual Manager</option>
              <option value="Permanent Couple">Permanent Management Couple</option>
              <option value="Relief Manager">Relief Manager</option>
              <option value="Fixed-Term Contract">Fixed-Term Contract</option>
              <option value="Unsure">Not Sure Yet</option>
            </select>
          </div>
          <div>
            <label for="v-rooms" class="block text-xs font-semibold uppercase tracking-widest text-stone-400 mb-1.5">Number of Rooms</label>
            <select id="v-rooms" name="room_count"
              class="w-full px-4 py-3 rounded-lg border border-stone-200 text-sm text-stone-900 focus:outline-none focus:ring-2 focus:ring-[#4A554E] focus:border-transparent">
              <option value="" disabled selected>Select range</option>
              <option value="Under 20">Under 20 rooms</option>
              <option value="20-40">20–40 rooms</option>
              <option value="41-80">41–80 rooms</option>
              <option value="80+">80+ rooms</option>
            </select>
          </div>
        </div>

        <div>
          <label for="v-message" class="block text-xs font-semibold uppercase tracking-widest text-stone-400 mb-1.5">Brief Details (Optional)</label>
          <textarea id="v-message" name="message" rows="4"
            placeholder="Tell us about the role, your property location, start date, or any other relevant details..."
            class="w-full px-4 py-3 rounded-lg border border-stone-200 text-sm text-stone-900 placeholder-stone-400 focus:outline-none focus:ring-2 focus:ring-[#4A554E] focus:border-transparent"></textarea>
        </div>

        <button type="submit"
          class="w-full inline-flex items-center justify-center gap-2 px-6 py-3.5 bg-[#4A554E] text-white text-sm font-semibold rounded-lg hover:bg-[#3d4640] transition-colors shadow-sm">
          Submit Vacancy Enquiry
        </button>
        <p class="text-xs text-stone-400">We'll respond within one business day. See our <a href="/privacy-policy/" class="underline hover:text-stone-600">Privacy Policy</a>.</p>
      </form>
    </div>
  </section>

  <script>
    (function () {
      const form = document.getElementById('vacancy-form-el');
      if (!form) return;
      form.addEventListener('submit', async function (e) {
        e.preventDefault();
        const btn = this.querySelector('button[type="submit"]') as HTMLButtonElement;
        const original = btn.textContent!.trim();
        const honeypot = this.querySelector('input[name="last_name_verification"]') as HTMLInputElement;
        if (honeypot && honeypot.value) return;
        btn.disabled = true;
        btn.textContent = 'Sending…';
        try {
          await fetch((this as HTMLFormElement).action, {
            method: 'POST',
            mode: 'no-cors',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
            body: new URLSearchParams(new FormData(this as HTMLFormElement)).toString(),
          });
        } catch (_) {}
        (this as HTMLFormElement).classList.add('hidden');
        document.getElementById('vacancy-success')!.classList.remove('hidden');
        btn.disabled = false;
        btn.textContent = original;
      });
    })();
  </script>

  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "Motel Manager Recruitment",
    "provider": {
      "@type": "Organization",
      "name": "Motel Coach",
      "url": "https://motelcoach.com.au/"
    },
    "description": "Specialist motel manager recruitment for independent Australian motels. Individual managers, couples, and relief management placements.",
    "areaServed": "AU",
    "serviceType": "Recruitment"
  }
  </script>
</BaseLayout>
