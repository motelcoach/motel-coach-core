<script>
  (function () {
    var btn = document.getElementById('wd-email-reveal-btn');
    var label = document.getElementById('wd-email-reveal-text');
    if (!btn || !label) return;
    var parts = ['contact', 'motelcoach.com.au'];
    var addr = parts[0] + '@' + parts[1];
    btn.addEventListener('click', function () {
      navigator.clipboard.writeText(addr).then(function () {
        label.textContent = 'Copied! ' + addr;
        btn.classList.add('ring-2', 'ring-[#4A554E]', 'bg-stone-50');
        setTimeout(function () {
          label.textContent = 'Email Ben';
          btn.classList.remove('ring-2', 'ring-[#4A554E]', 'bg-stone-50');
        }, 3000);
      }).catch(function () {
        label.textContent = addr;
      });
    });
  })();
</script>
