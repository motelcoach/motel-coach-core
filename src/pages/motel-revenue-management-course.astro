---
import BaseLayout from '../layouts/BaseLayout.astro';
import PartnerGrid from '../components/PartnerGrid.astro';
---

<BaseLayout title="Motel & Hotel Revenue Management Course | Motel Coach" description="Practical hotel and motel revenue management course. Online and self-paced interactive modules covering pricing, pickup control, and channel mix." hideFooterCta>
  <!-- Hero (Minimalist) -->
  <section class="bg-[#F9F9F8] border-b border-stone-200 pt-24 pb-16">
    <div class="max-w-6xl mx-auto px-6 text-center">
      <h1 class="text-5xl md:text-7xl font-semibold text-stone-900 tracking-tight text-balance" data-reveal="up">
        Motel &amp; Hotel Revenue Management Course
      </h1>
      <p class="mt-6 text-lg md:text-xl text-stone-500 leading-relaxed text-balance max-w-2xl mx-auto" data-reveal="up">
        Practical hotel and motel revenue management course. Online and Self-paced interactive modules.
      </p>
      <div class="mt-8" data-reveal="up">
        <a
          href="https://revenue.motelcoach.com.au/"
          class="inline-flex items-center justify-center rounded-lg bg-[#4A554E] px-8 py-4 text-base font-medium text-white shadow-sm hover:bg-[#3d4640] hover:shadow-lg transition"
        >
          Try the first chapter free
        </a>
        <p class="mt-3 text-sm text-stone-500">
          Full Course Cost $149
        </p>
      </div>
    </div>
  </section>

  <!-- What our students say -->
  <section class="bg-white py-16 md:py-20">
    <div class="max-w-6xl mx-auto px-6">
      <h2 class="text-2xl md:text-3xl font-semibold text-stone-900 tracking-tight text-balance mb-4 text-center">
        What our students say
      </h2>
      <p class="text-stone-500 leading-relaxed text-center mb-10 max-w-3xl mx-auto">
        Google reviews from past motel training and consultancy clients, including hospitality students, motel receptionists, motel managers, and motel owners.
      </p>
      <script src="https://static.elfsight.com/platform/platform.js" async is:inline></script>
      <div class="elfsight-app-b09bbb90-e770-4872-8334-f5b66579c51e" data-elfsight-app-lazy></div>
    </div>
  </section>

  <!-- Course Syllabus at a Glance -->
  <section id="curriculum" class="bg-white py-24 border-t border-stone-200">
    <div class="max-w-6xl mx-auto px-6">
      <div class="max-w-3xl mx-auto text-center" data-reveal="up">
        <h2 class="text-2xl md:text-3xl font-semibold text-stone-900 tracking-tight text-balance">
          Course syllabus at a glance
        </h2>
        <p class="mt-4 text-stone-500 leading-relaxed">
          Three modules that fix the biggest pricing mistakes and channel leakage.
        </p>
      </div>

      <div class="mt-10 max-w-2xl mx-auto rounded-2xl border border-stone-200 bg-[#F9F9F8] p-8" data-reveal="up">
        <ul class="space-y-4">
          {[
            'Pricing rules: set discipline you can run weekly without overthinking',
            'Pickup control: read pace and compression early (no panic discounting)',
            'Channel mix: protect margin with parity and inventory control',
          ].map((t) => (
            <li class="flex items-start gap-3 text-stone-500">
              <svg class="mt-0.5 h-5 w-5 text-stone-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M20 6 9 17l-5-5" />
              </svg>
              <span class="leading-relaxed">{t}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <PartnerGrid />

  <!-- Book CTA for those not ready -->
  <section class="bg-[#F9F9F8] py-12 border-t border-stone-200">
    <div class="max-w-4xl mx-auto px-6 flex flex-col md:flex-row items-center justify-between gap-4">
      <div>
        <p class="text-xs font-semibold uppercase tracking-widest text-[#4A554E] mb-1">Not Ready for a Course?</p>
        <h2 class="text-xl font-semibold text-stone-900">Start with The Motel Management Book</h2>
        <p class="text-stone-500 text-sm mt-1">190+ pages of operational frameworks, templates, and checklists.</p>
      </div>
      <a href="/motel-management-book/" class="flex-shrink-0 inline-flex items-center justify-center gap-2 px-6 py-3 bg-[#4A554E] text-white text-sm font-bold rounded-lg hover:bg-[#3d4640] transition-colors shadow-sm whitespace-nowrap">
        View the Book
      </a>
    </div>
  </section>
</BaseLayout>
