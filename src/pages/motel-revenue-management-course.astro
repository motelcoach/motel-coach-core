---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Motel Revenue Management Course | Motel Coach" description="Stop reactive pricing. Master the data-driven systems that drive high-yield assets. Join the Motel Revenue Management Course for early-bird access." hideFooterCta>
  <!-- Hero (Minimalist) -->
  <section class="bg-[#F9F9F8] border-b border-stone-200 pt-24 pb-16">
    <div class="max-w-6xl mx-auto px-6 text-center">
      <h1 class="text-5xl md:text-7xl font-semibold text-stone-900 tracking-tight text-balance" data-reveal="up">
        The Motel Revenue Management Course
      </h1>
      <p class="mt-6 text-lg md:text-xl text-stone-500 leading-relaxed text-balance max-w-2xl mx-auto" data-reveal="up">
        Practical revenue discipline for Australian motels—so you stop discounting and start controlling yield.
      </p>
      <a
        href="#waitlist"
        class="mt-8 inline-flex items-center justify-center rounded-lg bg-[#4A554E] px-8 py-4 text-base font-medium text-white shadow-sm hover:bg-[#3d4640] hover:shadow-lg transition"
        data-reveal="up"
      >
        Join the waitlist
      </a>
    </div>
  </section>

  <!-- Course Syllabus at a Glance -->
  <section class="bg-white py-24">
    <div class="max-w-6xl mx-auto px-6">
      <div class="max-w-3xl mx-auto text-center" data-reveal="up">
        <h2 class="text-2xl md:text-3xl font-semibold text-stone-900 tracking-tight text-balance">
          Course syllabus at a glance
        </h2>
        <p class="mt-4 text-stone-500 leading-relaxed">
          Three modules that fix the biggest pricing mistakes and channel leakage.
        </p>
      </div>

      <div class="mt-10 max-w-2xl mx-auto rounded-2xl border border-stone-200 bg-[#F9F9F8] p-8" data-reveal="up">
        <ul class="space-y-4">
          {[
            'Pricing rules: set discipline you can run weekly without overthinking',
            'Pickup control: read pace and compression early (no panic discounting)',
            'Channel mix: protect margin with parity and inventory control',
          ].map((t) => (
            <li class="flex items-start gap-3 text-stone-500">
              <svg class="mt-0.5 h-5 w-5 text-stone-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M20 6 9 17l-5-5" />
              </svg>
              <span class="leading-relaxed">{t}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- Waitlist Form -->
  <section id="waitlist" class="bg-white pb-24">
    <div class="max-w-6xl mx-auto px-6">
      <div class="max-w-xl mx-auto text-center" data-reveal="up">
        <h2 class="text-2xl md:text-3xl font-semibold text-stone-900 tracking-tight text-balance">
          Get notified when enrollment opens.
        </h2>
        <p class="mt-4 text-stone-500 leading-relaxed">
          Join the waitlist and we&apos;ll email you first.
        </p>
      </div>

      <div id="revenue-waitlist-success" class="hidden mt-8 max-w-xl mx-auto text-center py-6 bg-[#4A554E]/10 rounded-2xl">
        <p class="font-semibold text-stone-900 mb-1">You&apos;re on the list!</p>
        <p class="text-sm text-stone-500">We&apos;ll email you first when enrollment opens.</p>
      </div>
      <form id="revenue-waitlist-form" class="mt-8 max-w-xl mx-auto flex flex-col sm:flex-row gap-3" action="https://hooks.zapier.com/hooks/catch/26131104/upwyerc/" method="POST" data-reveal="up">
        <input type="hidden" name="source_page" value="Revenue Management Course" />
        <input type="hidden" name="form_type" value="waitlist" />
        <input type="hidden" name="waitlist" value="revenue-management-course" />
        <div class="hidden" aria-hidden="true">
          <input type="text" name="last_name_verification" value="" autocomplete="off" tabindex="-1" />
        </div>
        <input
          type="email"
          name="email"
          required
          placeholder="you@example.com"
          class="flex-1 px-4 py-3 rounded-lg border border-stone-200 bg-white text-sm text-stone-900 placeholder-stone-400 focus:outline-none focus:ring-2 focus:ring-[#4A554E] focus:border-transparent"
        />
        <label for="revenue-waitlist-type" class="sr-only">Operator Type</label>
        <select
          id="revenue-waitlist-type"
          name="operator_type"
          required
          class="flex-1 px-4 py-3 rounded-lg border border-stone-200 bg-white text-sm text-stone-900 focus:outline-none focus:ring-2 focus:ring-[#4A554E] focus:border-transparent"
        >
          <option value="" disabled selected>Select your profile...</option>
          <option value="I'm an Owner/Operator">I'm an Owner/Operator</option>
          <option value="I'm New to the Industry / Buying">I'm New to the Industry / Buying</option>
          <option value="I'm a Corporate Pro / Specialist">I'm a Corporate Pro / Specialist</option>
        </select>
        <button type="submit" class="px-6 py-3 rounded-lg bg-[#4A554E] text-white text-sm font-medium shadow-sm hover:bg-[#3d4640] hover:shadow-lg transition">
          Join waitlist
        </button>
      </form>

      <p class="mt-4 text-center text-xs text-stone-400" data-reveal="fade">
        Join other Australian operators improving their yield and channel mix.
      </p>
      <p class="mt-6 text-center text-xs text-stone-500 max-w-lg mx-auto bg-stone-50 p-4 rounded-lg border border-stone-100" data-reveal="fade">
        <strong>Note:</strong> These courses are designed for independent owners and general managers. If you are a specialized Corporate RM or Marketing Pro, this content may be too foundational for your needs.
      </p>
    </div>
  </section>
<script>
  document.getElementById('revenue-waitlist-form').addEventListener('submit', async function (e) {
    e.preventDefault();
    const btn = this.querySelector('button[type="submit"]');
    const original = btn.textContent.trim();

    const honeypot = this.querySelector('input[name="last_name_verification"]');
    if (honeypot && honeypot.value) return;

    btn.disabled = true;
    btn.textContent = 'Joining…';
    try {
      await fetch(this.action, { 
        method: 'POST', 
        mode: 'no-cors',
        headers: {
          'Content-Type': 'application/x-www-form-urlencoded'
        },
        body: new URLSearchParams(new FormData(this)).toString() 
      });
      this.classList.add('hidden');
      document.getElementById('revenue-waitlist-success').classList.remove('hidden');
    } catch {
      btn.disabled = false;
      btn.textContent = original;
      alert('Something went wrong. Please try again.');
    }
  });
</script>

  <!-- Book CTA for those not ready -->
  <section class="bg-[#F9F9F8] py-12 border-t border-stone-200">
    <div class="max-w-4xl mx-auto px-6 flex flex-col md:flex-row items-center justify-between gap-4">
      <div>
        <p class="text-xs font-semibold uppercase tracking-widest text-[#4A554E] mb-1">Not Ready for a Course?</p>
        <h2 class="text-xl font-semibold text-stone-900">Start with The Motel Management Book</h2>
        <p class="text-stone-500 text-sm mt-1">190+ pages of operational frameworks, templates, and checklists.</p>
      </div>
      <a href="/motel-management-book/" class="flex-shrink-0 inline-flex items-center justify-center gap-2 px-6 py-3 bg-[#4A554E] text-white text-sm font-bold rounded-lg hover:bg-[#3d4640] transition-colors shadow-sm whitespace-nowrap">
        View the Book
      </a>
    </div>
  </section>
</BaseLayout>
