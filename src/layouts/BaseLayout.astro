        <a href="/courses/" class="block text-2xl font-semibold text-stone-900 border-b border-stone-200 py-4 hover:text-[#4A554E] transition-colors" data-mobile-close>Courses</a>
        <a href="/motel-management-book/" class="block text-2xl font-semibold text-stone-900 border-b border-stone-200 py-4 hover:text-[#4A554E] transition-colors" data-mobile-close>Our Book</a>
        <a href="/motel-seo/" class="block text-2xl font-semibold text-stone-900 border-b border-stone-200 py-4 hover:text-[#4A554E] transition-colors" data-mobile-close>SEO</a>
        <a href="/contact/" class="block text-2xl font-semibold text-stone-900 border-b border-stone-200 py-4 hover:text-[#4A554E] transition-colors mt-2" data-mobile-close>
          <span class="inline-flex items-center gap-2">
            Contact
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="text-stone-400" aria-hidden="true" focusable="false">
