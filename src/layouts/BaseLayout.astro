              <li><a href="/about/" class="text-sm text-stone-500 hover:text-stone-900 transition-colors">About Us</a></li>
              <li><a href="/blog/" class="text-sm text-stone-500 hover:text-stone-900 transition-colors">Blog</a></li>
              <li><a href="/contact/" class="text-sm text-stone-500 hover:text-stone-900 transition-colors">Contact</a></li>
              <li><a href="https://www.reddit.com/user/Cute_Oil5593/" target="_blank" rel="noopener noreferrer" class="text-sm text-[#4A554E] hover:text-stone-900 transition-colors font-medium">Reddit Advice Hub</a></li>
