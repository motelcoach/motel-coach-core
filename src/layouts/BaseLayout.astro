    <!-- Single merged script: mobile menu + enquiry forms -->
    <script>
      import { WEB3FORMS_ACCESS_KEY } from '../lib/web3forms-key';

      // --- Mobile menu ---
      (function () {
        var openBtn    = document.getElementById('mobile-menu-open');
        var closeBtn   = document.getElementById('mobile-menu-close');
        var drawer     = document.getElementById('mobile-menu-drawer');
        var closeLinks = document.querySelectorAll('[data-mobile-close]');

        function openMenu() {
          drawer.classList.remove('hidden');
          drawer.setAttribute('aria-hidden', 'false');
          document.body.style.overflow = 'hidden';
        }

        function closeMenu() {
          drawer.classList.add('hidden');
          drawer.setAttribute('aria-hidden', 'true');
          document.body.style.overflow = '';
        }

        if (openBtn)  openBtn.addEventListener('click', openMenu);
        if (closeBtn) closeBtn.addEventListener('click', closeMenu);
        closeLinks.forEach(function (link) {
          link.addEventListener('click', closeMenu);
        });
      })();

      // --- Enquiry forms (Web3Forms) ---
      (function () {
        var subjects = {
          'general-contact': 'Motel Coach contact enquiry',
          'strategy-session': 'Motel Coach strategy session',
          'phone-call-booking': 'Motel Coach consultancy call',
          'vacancy-enquiry': 'Motel Coach manager vacancy',
          'performance-audit': 'Motel Coach performance audit',
          'buyers-audit': 'Motel Coach buyers audit',
          'waitlist': 'Motel Coach course waitlist',
          'website-audit': 'Motel Coach website audit',
          'keyword-scan': 'Motel Coach keyword scan',
          'motel-manager-jobs': 'Motel Coach manager application'
        };

        document.addEventListener('submit', function (e) {
          var form = e.target && e.target.closest ? e.target.closest('.enquiry-form') : null;
          if (!form || form.getAttribute('data-sending') === 'true') return;
          e.preventDefault();

          var honeypot = form.querySelector('input[name="last_name_verification"]');
          if (honeypot && honeypot.value) return;

          var submitBtn = form.querySelector('button[type="submit"]');
          var originalLabel = submitBtn ? submitBtn.textContent.trim() : 'Submit';

          function restoreButton() {
            form.removeAttribute('data-sending');
            if (submitBtn) {
              submitBtn.disabled = false;
              submitBtn.textContent = originalLabel;
            }
          }

          if (!WEB3FORMS_ACCESS_KEY) {
            alert('This form is not set up yet. Please email contact@motelcoach.com.au.');
            return;
          }

          form.querySelectorAll('input[name="website"]').forEach(function (input) {
            var value = input.value.trim();
            if (value && !/^https?:\/\//i.test(value)) input.value = 'https://' + value;
          });

          var payload = {
            access_key: WEB3FORMS_ACCESS_KEY,
            from_name: 'Motel Coach website'
          };
          new FormData(form).forEach(function (value, key) {
            if (key === 'last_name_verification' || typeof value !== 'string') return;
            var trimmed = value.trim();
            if (trimmed) payload[key] = trimmed;
          });
          if (!payload.subject && payload.form_type && subjects[payload.form_type]) {
            payload.subject = subjects[payload.form_type];
          }
          if (!payload.source_page) payload.source_page = window.location.pathname;

          form.setAttribute('data-sending', 'true');
          if (submitBtn) {
            submitBtn.disabled = true;
            submitBtn.textContent = 'Sending\u2026';
          }

          fetch('https://api.web3forms.com/submit', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
              Accept: 'application/json'
            },
            body: JSON.stringify(payload)
          })
            .then(function (response) {
              return response.json().then(function (result) {
                if (!response.ok || !result || !result.success) {
                  throw new Error((result && result.message) || 'Send failed');
                }
                return result;
              });
            })
            .then(function () {
              window.dataLayer = window.dataLayer || [];
              dataLayer.push({ event: 'form_submission', form_type: payload.form_type || 'enquiry' });
              if (payload.offer_tier === 'paid') {
                dataLayer.push({
                  event: 'form_submission',
                  form_type: 'paid-audit',
                  value: 99,
                  currency: 'AUD'
                });
              }

              var successSel = form.getAttribute('data-success');
              var successEl = successSel ? document.querySelector(successSel) : null;
              form.classList.add('hidden');
              if (successEl) successEl.classList.remove('hidden');
              else alert('Message received. We will reply by email.');
            })
            .catch(function (err) {
              console.error('Form submission error:', err);
              restoreButton();
              alert('Something went wrong. Please try again or email contact@motelcoach.com.au.');
            });
        });
      })();


    </script>

  </body>
</html>
