            <ul class="space-y-3">
              <li><a href="/motel-buyers-audit/" class="text-sm text-stone-500 hover:text-stone-900 transition-colors">Motel Buyers Audit</a></li>
              <li><a href="/operational-performance-audit/" class="text-sm text-stone-500 hover:text-stone-900 transition-colors">Performance Audit</a></li>
              <li><a href="/motel-website-design/" class="text-sm text-stone-500 hover:text-stone-900 transition-colors">Website Design</a></li>
              <li><a href="/become-motel-coach/" class="text-sm text-stone-500 hover:text-stone-900 transition-colors">Become a Motel Coach</a></li>
              <li><a href="/motel-revenue-management-course/" class="text-sm text-stone-500 hover:text-stone-900 transition-colors">Revenue Management Course</a></li>
            </ul>
          </div>

          <!-- Frameworks -->
          <div>
            <h3 class="font-medium text-stone-900 mb-4 text-sm">Frameworks</h3>
            <ul class="space-y-3">
              <li><a href="/courses/" class="text-sm text-stone-500 hover:text-stone-900 transition-colors">Courses</a></li>
