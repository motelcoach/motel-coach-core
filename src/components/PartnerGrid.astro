---
const partners = [
  { name: "GuestPoint", src: "/images/legacy/GuestPoint-PMS.webp" },
  { name: "Casa Nostra Motel", src: "/images/legacy/Casa-Nostra-Motel-Logo.webp" },
  { name: "Crossroads Eco Motel", src: "/images/legacy/motel-consultancy-client-ecomotel.png" },
  { name: "Alan Cunningham Motel", src: "/images/legacy/Allan-Cunningham-Motel_Logo.webp" },
  { name: "SiteMinder", src: "/images/legacy/siteminder-motel-channel-manager.webp" },
  { name: "Accom News", src: "/images/legacy/motel-management-news.webp" },
  { name: "True Blue Motor Inn", src: "/images/legacy/True-Blue-Motor-Inn.webp" },
  { name: "Casa Nostra Motel Mackay", src: "/images/legacy/Casa-Nostra-Mackay-Motel-Logo.webp" },
  { name: "Kismet Hotel", src: "/images/legacy/Kismet-Hotel-Logo.png", dark: true },
  { name: "Southport Shores Motel", src: "/images/legacy/Southport-Shores-Motel-Logo.png" },
  { name: "Miami Motel", src: "/images/legacy/Miami-Motel-Logo.png", dark: true },
  { name: "Centrepoint Motel", src: "/images/legacy/Centrepoint-Motel-Logo.png" },
];
---

<section class="py-16 md:py-20 bg-white border-t border-stone-200">
  <div class="max-w-7xl mx-auto px-6">
    
    <div class="text-center mb-10 md:mb-14">
      <h2 class="text-base md:text-xl font-bold text-[#4A554E] uppercase tracking-widest">
        Proven in the field. Supported by the industry.
      </h2>
    </div>
    
    <div class="grid grid-cols-2 md:grid-cols-4 gap-x-8 gap-y-12 items-center justify-items-center">
      {partners.map((partner) => (
        <div class="group flex items-center justify-center w-full h-16 md:h-20 transition-all duration-300 cursor-pointer">
          <img 
            src={partner.src} 
            alt={`${partner.name} - Motel Coach Partner`} 
            width="200"
            height="80"
            class:list={[
              "max-h-full max-w-full object-contain transition-all duration-400 ease-in-out group-hover:opacity-100 group-hover:scale-105 group-hover:drop-shadow-sm",
              partner.dark
                ? "rounded-md opacity-70 grayscale group-hover:grayscale-0"
                : "filter grayscale opacity-50 mix-blend-multiply group-hover:grayscale-0",
            ]}
            loading="lazy"
          />
        </div>
      ))}
    </div>

  </div>
</section>
